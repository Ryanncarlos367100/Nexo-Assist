# ─────────────────────────────────────────────────────────────────────────────
# Nexo Assist — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Provedor de LLM usado pelo agent. Valores suportados: google | anthropic | openai
# (default: google). O app também roda SEM chave em "modo demo" determinístico.
LLM_PROVIDER=google

# Nome do modelo usado para o provider escolhido. Se omitido, usa o default do provider:
#   google    -> gemini-2.0-flash
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-4o-mini
LLM_MODEL=

# ── Chaves de API ──
# Preencha APENAS a chave do provider que você escolheu em LLM_PROVIDER.
# Se nenhuma chave for fornecida, o agent usa o motor de decisão determinístico
# (as mesmas regras testadas), sem gerar linguagem natural via LLM.

# Google Gemini (default). Gere em https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic Claude (opcional). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (opcional). https://platform.openai.com/
OPENAI_API_KEY=

# ── Persistência ──
# Caminho do arquivo SQLite (default: ./data/nexo.db).
DATABASE_PATH=./data/nexo.db

# ── Sessão ──
# Segredo usado para assinar o cookie de sessão. Troque por um valor aleatório.
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
